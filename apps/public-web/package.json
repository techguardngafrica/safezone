    "@safezone/types": "workspace:*",
    "@safezone/web-ui": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "vitest": "^5.1.0"
