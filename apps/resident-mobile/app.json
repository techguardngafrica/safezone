{
  "expo": {
    "name": "Safezone",
    "slug": "safezone-resident",
    "scheme": "safezone",
    "version": "0.0.0",
    "orientation": "portrait",
    "primaryColor": "#254D42",
    "backgroundColor": "#FAF7F2",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ng.gsssecurity.safezone.resident",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Safezone shares your location with estate security only while an SOS alert is active."
      }
    },
    "android": {
      "package": "ng.gsssecurity.safezone.resident",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "realtimeUrl": "ws://localhost:4001",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f6ead487-a4dd-4857-a7ea-0c9ab659ef3f"
      }
    },
    "owner": "techguard",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6ead487-a4dd-4857-a7ea-0c9ab659ef3f"
    }
  }
}
