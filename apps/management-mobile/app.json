{
  "expo": {
    "name": "Safezone Estate",
    "slug": "safezone-management",
    "scheme": "safezone-estate",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "ng.safezone.management", "supportsTablet": true },
    "android": { "package": "ng.safezone.management", "permissions": ["POST_NOTIFICATIONS"] },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "realtimeUrl": "ws://localhost:4001"
    }
  }
}
