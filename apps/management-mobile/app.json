{
  "expo": {
    "name": "Safezone Management",
    "slug": "safezone-management",
    "scheme": "safezone-management",
    "version": "0.0.0",
    "orientation": "portrait",
    "primaryColor": "#254D42",
    "backgroundColor": "#FAF7F2",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ng.gsssecurity.safezone.management",
      "supportsTablet": true
    },
    "android": {
      "package": "ng.gsssecurity.safezone.management",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "realtimeUrl": "ws://localhost:4001"
    }
  }
}
