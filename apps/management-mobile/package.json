{
  "name": "@safezone/management-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Estate Management App \u2014 mobile (Expo). Same backend, rules and permissions as management-web.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ../../scripts/phone-env.mjs && EXPO_NO_REDIRECT_PAGE=1 expo start --go",
    "run:android": "expo run:android --device",
    "run:ios": "expo run:ios --device",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android --clear-cache",
    "build:preview:ios": "eas build --profile preview --platform ios --clear-cache",
    "build:prod:android": "eas build --profile production --platform android --clear-cache",
    "build:prod:ios": "eas build --profile production --platform ios --clear-cache",
    "submit:prod:android": "eas submit --profile production --platform android",
    "submit:prod:ios": "eas submit --profile production --platform ios",
    "submit:prod": "eas submit --profile production --platform all",
    "submit:prod-store:android": "eas submit --profile production-store --platform android",
    "update:preview-android": "eas update --branch preview --platform android --message",
    "update:prod-android": "eas update --branch production --platform android --message",
    "update:preview-ios": "eas update --branch preview --platform ios --message",
    "update:prod-ios": "eas update --branch production --platform ios --message",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "vitest run --passWithNoTests",
    "doctor": "expo install --check",
    "clean": "rm -rf .expo .turbo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@safezone/api-client": "workspace:*",
    "@safezone/auth": "workspace:*",
    "@safezone/contracts": "workspace:*",
    "@safezone/design-tokens": "workspace:*",
    "@safezone/i18n": "workspace:*",
    "@safezone/mobile-ui": "workspace:*",
    "@safezone/permissions": "workspace:*",
    "@safezone/schemas": "workspace:*",
    "@safezone/types": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "vitest": "^5.1.0"
  }
}
