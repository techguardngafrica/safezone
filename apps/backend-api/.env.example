# Server Runtime
NODE_ENV=development
PORT=4000
WORKER_PORT=4001
REALTIME_PORT=4002
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://safezone:safezone_dev_password@localhost:5432/safezone?schema=public

# Redis (Cache + BullMQ + Realtime Pub/Sub)
REDIS_URL=redis://localhost:6379

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_SECRET=replace-with-a-secure-32-char-minimum-secret
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

