  @@index([estateId, status])
  @@index([transactionId])
  @@map("refunds")
  @@schema("tenant")
}

/// Maps provider references and customer codes to an estate, so webhooks (which carry no estate)
/// can be processed inside the right tenant (payments context only).
model PaymentRoute {
  provider  String
  routeKey  String   @map("route_key")
  /// intent | virtual_account | refund
  kind      String
  estateId  String   @map("estate_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([provider, routeKey])
  @@map("payment_routes")
  @@schema("platform")
}

/// Received provider webhooks (minimised: no card or account data). De-duplicated on event id.
model PaymentWebhookEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  provider       String
  eventId        String    @map("event_id")
  type           String
  reference      String?
  customerCode   String?   @map("customer_code")
  signatureValid Boolean   @map("signature_valid")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
