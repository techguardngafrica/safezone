// ---- Community channels, moderation and polls (community.md, Phase 3; ADR-0015) ------------------

model Channel {
  id          String    @id @default(uuid(7)) @db.Uuid
  estateId    String    @map("estate_id") @db.Uuid
  /// building | estate | resident | direct
  type        String
  /// Building channels: the building (or block) space. Estate channels: null.
  spaceId     String?   @map("space_id") @db.Uuid
  /// Seeded estate channels: general, security_updates, …; direct: sorted user ids.
  key         String?
  name        String
  description String?
  category    String?
  /// public | restricted | invite_only
  privacy     String    @default("public")
  /// pending_approval | active | suspended | archived
  status      String    @default("active")
  staffOnly   Boolean   @default(false) @map("staff_only")
  createdBy   String?   @map("created_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(3)

  @@unique([estateId, type, key])
  @@index([estateId, type, status])
  @@map("channels")
  @@schema("tenant")
}

/// Explicit members (resident and direct channels) and per-user preferences on derived channels.
model ChannelMember {
  estateId   String    @map("estate_id") @db.Uuid
  channelId  String    @map("channel_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// owner | moderator | member
  role       String    @default("member")
  /// active | requested | invited | removed
  status     String    @default("active")
  /// all | mentions | none
  notify     String    @default("all")
  mutedUntil DateTime? @map("muted_until") @db.Timestamptz(3)
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)

  @@id([channelId, userId])
  @@index([estateId, userId, status])
  @@map("channel_members")
  @@schema("tenant")
}

model Message {
  id                  String    @id @default(uuid(7)) @db.Uuid
  estateId            String    @map("estate_id") @db.Uuid
  channelId           String    @map("channel_id") @db.Uuid
  authorId            String    @map("author_id") @db.Uuid
  body                String
  replyToId           String?   @map("reply_to_id") @db.Uuid
  attachmentFileIds   String[]  @map("attachment_file_ids") @db.Uuid
  mentionUserIds      String[]  @map("mention_user_ids") @db.Uuid
  editedAt            DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  removedByModeration Boolean   @default(false) @map("removed_by_moderation")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([channelId, createdAt])
  @@index([estateId, authorId])
  @@map("messages")
  @@schema("tenant")
}

model MessageReaction {
  estateId  String   @map("estate_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
  @@schema("tenant")
}

model UserBlock {
  estateId  String   @map("estate_id") @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([estateId, blockerId, blockedId])
  @@map("user_blocks")
  @@schema("tenant")
}

model CommunityProfile {
  estateId             String    @map("estate_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  guidelinesAcceptedAt DateTime? @map("guidelines_accepted_at") @db.Timestamptz(3)
  /// Estate-wide mute (moderation) until this time.
  mutedUntil           DateTime? @map("muted_until") @db.Timestamptz(3)
  /// Estate-wide ban; null when not banned, far future for permanent.
  bannedUntil          DateTime? @map("banned_until") @db.Timestamptz(3)
  warnings             Int       @default(0)

  @@id([estateId, userId])
  @@map("community_profiles")
  @@schema("tenant")
}

model CommunityReport {
  id         String    @id @default(uuid(7)) @db.Uuid
  estateId   String    @map("estate_id") @db.Uuid
  /// message | channel | user
  targetType String    @map("target_type")
  targetId   String    @map("target_id") @db.Uuid
  reason     String
  details    String?
  reportedBy String    @map("reported_by") @db.Uuid
  /// open | actioned | dismissed
  status     String    @default("open")
  handledBy  String?   @map("handled_by") @db.Uuid
  handledAt  DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([targetType, targetId, reportedBy])
  @@index([estateId, status, createdAt])
  @@map("community_reports")
  @@schema("tenant")
}

model ModerationAction {
  id              String    @id @default(uuid(7)) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  action          String
  targetType      String    @map("target_type")
  targetId        String    @map("target_id") @db.Uuid
  /// The user the action applies to (author of a removed message, muted or banned user).
  subjectUserId   String?   @map("subject_user_id") @db.Uuid
  channelId       String?   @map("channel_id") @db.Uuid
  reason          String
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(3)
  moderatorId     String    @map("moderator_id") @db.Uuid
  reportId        String?   @map("report_id") @db.Uuid
  /// none | pending | upheld | overturned
  appealStatus    String    @default("none") @map("appeal_status")
  appealStatement String?   @map("appeal_statement")
  appealDecidedBy String?   @map("appeal_decided_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([estateId, createdAt])
  @@index([estateId, subjectUserId])
  @@map("moderation_actions")
  @@schema("tenant")
}

model Poll {
  id              String   @id @default(uuid(7)) @db.Uuid
  estateId        String   @map("estate_id") @db.Uuid
  question        String
  closesAt        DateTime @map("closes_at") @db.Timestamptz(3)
  anonymous       Boolean  @default(false)
  /// user | household
  votePer         String   @default("user") @map("vote_per")
  /// estate | spaces
  audienceType    String   @map("audience_type")
  audienceUnitIds String[] @map("audience_unit_ids") @db.Uuid
  createdBy       String   @map("created_by") @db.Uuid
  closedNotified  Boolean  @default(false) @map("closed_notified")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  options PollOption[]

  @@index([estateId, closesAt])
  @@map("polls")
  @@schema("tenant")
}

model PollOption {
  id       String @id @default(uuid(7)) @db.Uuid
  estateId String @map("estate_id") @db.Uuid
  pollId   String @map("poll_id") @db.Uuid
  label    String
  position Int

  poll Poll @relation(fields: [pollId], references: [id])

  @@index([pollId])
  @@map("poll_options")
  @@schema("tenant")
}

model PollVote {
  id       String   @id @default(uuid(7)) @db.Uuid
  estateId String   @map("estate_id") @db.Uuid
  pollId   String   @map("poll_id") @db.Uuid
  optionId String   @map("option_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  /// The voting unit: the user, or their household when the poll is one vote per household.
  voterKey String   @map("voter_key")
  votedAt  DateTime @default(now()) @map("voted_at") @db.Timestamptz(3)

  @@unique([pollId, voterKey])
  @@map("poll_votes")
  @@schema("tenant")
}
