// Safezone Prisma schema. ORM decision: docs/architecture/adr/0001-orm-and-data-access.md
//
// Rules (docs/database/README.md):
// - Tables and columns are snake_case (@@map / @map). Models are PascalCase.
// - IDs are UUIDv7, generated by the client. Times are timestamptz(3) in UTC.
// - Row-level security policies, FORCE RLS and grants to safezone_app are NOT expressible here:
//   append them to the migration SQL (prisma migrate dev --create-only) before applying.
// - A module owns its tables. Module models are added in phase order.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform", "tenant", "audit"]
}

/// Transactional outbox (backend-api.md §10). Written in the same transaction as the state change;
/// relayed to BullMQ by the worker. Not exposed through any endpoint. RLS: a transaction may insert
/// events for its own estate (or platform events); only the relay context reads and updates them.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  /// <module>.<entity>.<past-tense-verb>, e.g. visitor.pass.revoked
  type          String
  version       Int       @default(1) @db.SmallInt
  /// Null for platform-level events.
  estateId      String?   @map("estate_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json      @db.JsonB
  /// Audit record for this event, if the action must be audited (written by the audit consumer).
  audit         Json?     @db.JsonB
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([occurredAt], map: "outbox_events_pending_idx")
  @@map("outbox_events")
  @@schema("platform")
}

/// Append-only audit trail (modules/audit.md §3). safezone_app has INSERT and SELECT only.
/// Estate rows are readable in that estate's context; the audit consumer writes every stream
/// (including platform-level rows with estate_id null) in the 'audit' context.
model AuditEvent {
  id               String   @id @default(uuid(7)) @db.Uuid
  /// Insertion order; the hash chain of each stream follows it.
  seq              BigInt   @default(autoincrement())
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  estateId         String?  @map("estate_id") @db.Uuid
  /// user | guard_device | system | provider_webhook | platform_staff
  actorType        String   @map("actor_type")
  actorId          String?  @map("actor_id")
  actingRole       String?  @map("acting_role")
  supportSessionId String?  @map("support_session_id") @db.Uuid
  action           String
  resourceType     String   @map("resource_type")
  resourceId       String?  @map("resource_id")
  /// Changed fields only. Personal data minimised; secrets never.
  before           Json?    @db.JsonB
  after            Json?    @db.JsonB
  reason           String?
  ip               String?  @db.Inet
  userAgent        String?  @map("user_agent")
  deviceId         String?  @map("device_id")
  app              String?
  requestId        String?  @map("request_id")
  /// Source outbox event; unique so the audit consumer is idempotent.
  sourceEventId    String?  @unique @map("source_event_id") @db.Uuid
  /// Per-estate hash chain for tamper evidence: hash = sha256(prev_hash + canonical_json(record)).
  hash             String
  prevHash         String?  @map("prev_hash")

  @@index([estateId, occurredAt])
  @@index([estateId, seq])
  @@index([resourceType, resourceId])
  @@map("audit_events")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// identity (modules/identity.md). Platform-level: no estate_id.
// RLS: rows are visible to the owning user (app.user_id) or inside withContext('identity').
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  phoneE164       String    @unique @map("phone_e164")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  email           String?
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  fullName        String?   @map("full_name")
  locale          String    @default("en")
  /// active | locked | deleted
  status          String    @default("active")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  devices       UserDevice[]
  mfaFactors    MfaFactor[]
  recoveryCodes RecoveryCode[]

  @@map("users")
  @@schema("platform")
}

model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  phoneE164  String    @map("phone_e164")
  /// signin | phone_change | sensitive_action
  purpose    String
  /// HMAC-SHA256(OTP_HMAC_SECRET, id:code). The code itself is never stored or logged.
  codeHash   String    @map("code_hash")
  /// sms | whatsapp
  channel    String
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, purpose, createdAt])
  @@map("otp_challenges")
  @@schema("platform")
}

/// One session per device sign-in. A session is the refresh-token family (ADR-0005).
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String?   @map("device_id") @db.Uuid
  app           String
  ip            String?   @db.Inet
  userAgent     String?   @map("user_agent")
  /// Set once MFA is satisfied for this session (or not needed when it was created).
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// signout | user_revoked | refresh_reuse | expired | support | phone_changed
  revokedReason String?   @map("revoked_reason")

  user          User           @relation(fields: [userId], references: [id])
  device        UserDevice?    @relation(fields: [deviceId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
  @@schema("platform")
}

/// Every refresh token ever issued for a session. Presenting a used one revokes the session (reuse detection).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// HMAC-SHA256(JWT_REFRESH_SECRET, token)
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("refresh_tokens")
  @@schema("platform")
}

model UserDevice {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// android | ios | web
  platform   String
  model      String?
  app        String
  appVersion String   @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id])
  sessions   Session[]
  pushTokens PushToken[]

  @@index([userId])
  @@map("user_devices")
  @@schema("platform")
}

model MfaFactor {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// totp
  type            String    @default("totp")
  /// AES-256-GCM(MFA_ENCRYPTION_KEY, base32 secret): iv.tag.ciphertext, base64url
  secretEncrypted String    @map("secret_encrypted")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Last accepted 30-second step; codes for this step or earlier are rejected (replay protection).
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_factors")
  @@schema("platform")
}

model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("recovery_codes")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// authz (modules/authz.md). Built-in role definitions live in @safezone/permissions;
// the roles table mirrors them (seeded) so assignments can reference them.
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// platform | estate | vendor | advertiser
  level     String
  key       String
  name      String
  isBuiltin Boolean  @default(false) @map("is_builtin")
  /// Null for built-in roles; set for custom estate roles.
  estateId  String?  @map("estate_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([estateId, key])
  @@map("roles")
  @@schema("platform")
}

/// Permissions of custom roles. Built-in role permissions come from @safezone/permissions at runtime.
model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id])

  @@id([roleId, permission])
  @@map("role_permissions")
  @@schema("platform")
}

model RoleAssignment {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  /// Null for platform roles.
  estateId  String?   @map("estate_id") @db.Uuid
  /// building | gate | department | facility (Phase 1+)
  scopeType String?   @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy String?   @map("revoked_by") @db.Uuid
  reason    String?

  role Role @relation(fields: [roleId], references: [id])

  @@index([userId, revokedAt])
  @@index([estateId])
  @@map("role_assignments")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// tenancy core (modules/tenancy.md). estates is the tenant registry (platform schema);
// memberships, settings and entitlements are tenant data (RLS on estate_id).
// ---------------------------------------------------------------------------

model Estate {
  id               String    @id @default(uuid(7)) @db.Uuid
  name             String
  slug             String    @unique
  /// Short join code shown to residents.
  code             String    @unique
  /// gated_houses | apartment_complex | mixed
  type             String
  address          String?
  state            String?
  lga              String?
  timezone         String    @default("Africa/Lagos")
  currency         String    @default("NGN")
  /// applied | under_review | info_requested | approved | active | suspended | deactivated | rejected
  status           String    @default("approved")
  /// self_service | assisted
  onboardingMode   String    @map("onboarding_mode")
  planKey          String    @default("core") @map("plan_key")
  approvedBy       String?   @map("approved_by") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(3)
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspensionReason String?   @map("suspension_reason")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("estates")
  @@schema("platform")
}

model EstateMembership {
  id       String    @id @default(uuid(7)) @db.Uuid
  estateId String    @map("estate_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  /// pending | active | suspended | left
  status   String    @default("active")
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  @@unique([estateId, userId])
  @@index([userId])
  @@map("estate_memberships")
  @@schema("tenant")
}

model EstateSetting {
  estateId  String   @map("estate_id") @db.Uuid
  key       String
  value     Json     @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([estateId, key])
  @@map("estate_settings")
  @@schema("tenant")
}

/// Per-estate overrides of the plan's features. Absent row = the plan decides.
model Entitlement {
  estateId   String    @map("estate_id") @db.Uuid
  featureKey String    @map("feature_key")
  enabled    Boolean
  /// core_plan | premium | override
  source     String    @default("override")
  validTo    DateTime? @map("valid_to") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([estateId, featureKey])
  @@map("entitlements")
  @@schema("tenant")
}

/// Plans framework only. Every estate is on `core` (free) at launch; no pricing.
model Plan {
  key       String   @id
  name      String
  features  String[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("plans")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// notifications core (modules/notifications.md). Platform schema: a notification may have no estate.
// RLS: the recipient reads their own rows; the notifications module (worker) writes in its context.
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level notifications (e.g. account security).
  estateId  String?   @map("estate_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  intentKey String    @map("intent_key")
  /// critical | high | normal | bulk
  priority  String
  title     String
  body      String
  /// Deep-link data for the app; never personal data of other people beyond what the intent needs.
  data      Json      @default("{}") @db.JsonB
  /// Source event or caller dedupe key: one notification per user per key.
  dedupeKey String    @map("dedupe_key")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)

  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("platform")
}

model NotificationDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  /// push | sms | email | whatsapp | voice
  channel        String
  provider       String
  /// Masked address (phone/email) or push token id. Never a raw token.
  toAddress      String    @map("to_address")
  /// queued | sent | delivered | failed
  status         String
  providerRef    String?   @map("provider_ref")
  error          String?
  costKobo       Int?      @map("cost_kobo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([channel, status, sentAt])
  @@map("notification_deliveries")
  @@schema("platform")
}

model PushToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  deviceId   String?   @map("device_id") @db.Uuid
  app        String
  /// ExponentPushToken[...]
  expoToken  String    @unique @map("expo_token")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  invalidAt  DateTime? @map("invalid_at") @db.Timestamptz(3)

  device UserDevice? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@map("push_tokens")
  @@schema("platform")
}

model NotificationPreference {
  userId   String  @map("user_id") @db.Uuid
  /// Category from the intent catalogue (e.g. community, billing, maintenance).
  category String
  /// push | sms | email | whatsapp
  channel  String
  enabled  Boolean

  @@id([userId, category, channel])
  @@map("notification_preferences")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// file service (modules/documents.md, Phase 0 part). Estate files are tenant-visible; personal files
// (estate_id null) only to their uploader. The worker scans in the 'files' context.
// ---------------------------------------------------------------------------

model StoredFile {
  id         String    @id @default(uuid(7)) @db.Uuid
  estateId   String?   @map("estate_id") @db.Uuid
  /// avatar | estate_application | pass_photo | maintenance | incident_evidence | document | import
  purpose    String
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  /// SHA-256 of the stored (metadata-stripped) content, for evidence integrity.
  sha256     String?
  /// awaiting_upload | pending_scan | clean | infected | rejected | error
  scanStatus String    @default("awaiting_upload") @map("scan_status")
  uploadedBy String    @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt DateTime? @map("uploaded_at") @db.Timestamptz(3)
  scannedAt  DateTime? @map("scanned_at") @db.Timestamptz(3)
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(3)

  @@index([estateId, purpose])
  @@index([uploadedBy])
  @@map("files")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// platform config (modules/platform.md): feature flags and app versions. Not personal data:
// readable everywhere, written only in the 'platform_config' context.
// ---------------------------------------------------------------------------

model FeatureFlag {
  key            String   @id
  description    String
  defaultEnabled Boolean  @default(false) @map("default_enabled")
  /// { estateIds?, apps?, minAppVersion?, percent? }: see modules/platform/flag-rules.ts
  rules          Json     @default("{}") @db.JsonB
  /// Public flags are returned by GET /v1/public/app-config (before sign-in).
  isPublic       Boolean  @default(false) @map("is_public")
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
  @@schema("platform")
}

model AppVersion {
  app                String
  /// android | ios | web
  platform           String
  minVersion         String   @map("min_version")
  recommendedVersion String   @map("recommended_version")
  message            String?
  updatedBy          String?  @map("updated_by") @db.Uuid
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([app, platform])
  @@map("app_versions")
  @@schema("platform")
}

// ---------------------------------------------------------------------------------------------------
// Tenancy: estate onboarding (Phase 1, tenancy.md §4–5). Applications, leads and invitations exist
// before (or outside) an estate, so they live in the platform schema behind the tenancy context.
// ---------------------------------------------------------------------------------------------------

/// Self-service application. Lifecycle in modules/tenancy/domain/application-status.ts.
model EstateApplication {
  id                  String    @id @default(uuid(7)) @db.Uuid
  applicantUserId     String    @map("applicant_user_id") @db.Uuid
  representativeName  String    @map("representative_name")
  representativeEmail String    @map("representative_email")
  /// owner | developer | manager | residents_association_officer
  representativeRole  String    @map("representative_role")
  estateName          String    @map("estate_name")
  /// gated_houses | apartment_complex | mixed
  estateType          String    @map("estate_type")
  address             String
  state               String
  lga                 String
  /// WGS84; plain columns until PostGIS lands (docs/database/postgis.md).
  latitude            Float?
  longitude           Float?
  unitsEstimate       Int       @map("units_estimate")
  gatesEstimate       Int       @map("gates_estimate")
  /// submitted | under_review | info_requested | approved | rejected | withdrawn
  status              String    @default("submitted")
  reviewerId          String?   @map("reviewer_id") @db.Uuid
  /// What Techguard asked for (info_requested) or why it was rejected.
  decisionReason      String?   @map("decision_reason")
  estateId            String?   @unique @map("estate_id") @db.Uuid
  submittedAt         DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(3)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents EstateApplicationDocument[]

  @@index([applicantUserId])
  @@index([status, submittedAt])
  @@map("estate_applications")
  @@schema("platform")
}

model EstateApplicationDocument {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  fileId        String   @map("file_id") @db.Uuid
  /// proof_of_authority (more types later)
  docType       String   @default("proof_of_authority") @map("doc_type")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application EstateApplication @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, fileId])
  @@map("estate_application_documents")
  @@schema("platform")
}

/// Techguard-assisted onboarding request from public-web.
model OnboardingLead {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  phone         String
  email         String?
  estateName    String   @map("estate_name")
  location      String
  unitsEstimate Int?     @map("units_estimate")
  message       String?
  /// new | contacted | converted | closed
  status        String   @default("new")
  ownerUserId   String?  @map("owner_user_id") @db.Uuid
  estateId      String?  @map("estate_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("onboarding_leads")
  @@schema("platform")
}

/// Invitation to administer an estate. Only a SHA-256 of the token is stored.
model EstateInvitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  estateId   String    @map("estate_id") @db.Uuid
  phone      String
  email      String?
  roleKey    String    @map("role_key")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedBy String?   @map("accepted_by") @db.Uuid
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedBy  String    @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([estateId])
  @@map("estate_invitations")
  @@schema("platform")
}

/// Setup wizard progress (tenancy.md §7.4).
model EstateSetupStep {
  estateId    String   @map("estate_id") @db.Uuid
  /// profile | spaces | gates | security_supervisor | sos_policy | residents
  step        String
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  completedBy String?  @map("completed_by") @db.Uuid

  @@id([estateId, step])
  @@map("estate_setup_progress")
  @@schema("tenant")
}

/// Messages to a phone or email that is not (yet) a user, e.g. invitations. One row per channel send.
model ContactDelivery {
  id          String    @id @default(uuid(7)) @db.Uuid
  dedupeKey   String    @map("dedupe_key")
  intentKey   String    @map("intent_key")
  /// sms | email
  channel     String
  /// Masked address only.
  toAddress   String    @map("to_address")
  /// claimed | sent | failed
  status      String    @default("claimed")
  providerRef String?   @map("provider_ref")
  error       String?
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([dedupeKey, channel])
  @@map("contact_deliveries")
  @@schema("platform")
}

// ---------------------------------------------------------------------------------------------------
// Property: the spaces tree (Phase 1, property.md). Ownership and transfers arrive in Phase 2.
// ---------------------------------------------------------------------------------------------------

/// One node of the estate's physical tree: phase, zone, street, block, building, floor, unit or common area.
/// `path` is a materialised path of compact ids ("<id>.<id>…"), indexed for prefix search (ADR-0009).
model Space {
  id          String    @id @default(uuid(7)) @db.Uuid
  estateId    String    @map("estate_id") @db.Uuid
  /// Null for top-level spaces (their parent is the estate).
  parentId    String?   @map("parent_id") @db.Uuid
  /// phase | zone | street | block | building | floor | unit | common_area
  type        String
  code        String
  name        String
  path        String
  depth       Int
  /// Units only: house | flat | shop | office | other
  unitType    String?   @map("unit_type")
  bedrooms    Int?
  sizeSqm     Float?    @map("size_sqm")
  /// Units only: vacant | occupied | under_construction | reserved
  status      String?
  /// Import key, unique per estate (re-import updates).
  externalRef String?   @map("external_ref")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Space?  @relation("SpaceTree", fields: [parentId], references: [id], onDelete: Restrict, map: "spaces_parent_fkey")
  children Space[] @relation("SpaceTree")

  @@unique([estateId, path])
  @@index([estateId, parentId])
  @@index([estateId, type, status])
  @@map("spaces")
  @@schema("tenant")
}

// ---------------------------------------------------------------------------------------------------
// Occupancy (Phase 1, occupancy.md): who lives in or uses a unit. Move-in/out workflows are Phase 2.
// ---------------------------------------------------------------------------------------------------

model Household {
  id         String    @id @default(uuid(7)) @db.Uuid
  estateId   String    @map("estate_id") @db.Uuid
  spaceId    String    @map("space_id") @db.Uuid
  headUserId String    @map("head_user_id") @db.Uuid
  name       String
  /// active | ended
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)

  members     HouseholdMember[]
  occupancies Occupancy[]

  @@index([estateId, spaceId, status])
  @@map("households")
  @@schema("tenant")
}

model HouseholdMember {
  id           String    @id @default(uuid(7)) @db.Uuid
  estateId     String    @map("estate_id") @db.Uuid
  householdId  String    @map("household_id") @db.Uuid
  /// Null for minors without an app account.
  userId       String?   @map("user_id") @db.Uuid
  fullName     String    @map("full_name")
  /// head | spouse | child | relative | tenant_co_occupant | other
  relationship String
  isMinor      Boolean   @default(false) @map("is_minor")
  /// { inviteVisitors, triggerSos, payBills, viewBills, receiveGateAlerts }
  permissions  Json      @db.JsonB
  /// active | removed
  status       String    @default("active")
  joinedAt     DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt       DateTime? @map("left_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id])

  @@index([estateId, userId, status])
  @@index([householdId])
  @@map("household_members")
  @@schema("tenant")
}

model Occupancy {
  id          String    @id @default(uuid(7)) @db.Uuid
  estateId    String    @map("estate_id") @db.Uuid
  spaceId     String    @map("space_id") @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  /// owner_occupier | tenant | other
  type        String
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  /// active | ended
  status      String    @default("active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  endedBy     String?   @map("ended_by") @db.Uuid

  household Household @relation(fields: [householdId], references: [id])

  @@index([estateId, spaceId, status])
  @@map("occupancies")
  @@schema("tenant")
}

model JoinRequest {
  id              String    @id @default(uuid(7)) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  spaceId         String    @map("space_id") @db.Uuid
  /// owner | tenant | household_member
  relationship    String
  /// Target household (household_member requests).
  householdId     String?   @map("household_id") @db.Uuid
  fullName        String    @map("full_name")
  message         String?
  evidenceFileIds String[]  @map("evidence_file_ids") @db.Uuid
  /// awaiting_household_head | awaiting_owner | awaiting_manager | approved | rejected | cancelled | expired
  status          String
  decidedBy       String?   @map("decided_by") @db.Uuid
  reason          String?
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)

  @@index([estateId, status, createdAt])
  @@index([userId])
  @@map("join_requests")
  @@schema("tenant")
}

model Vehicle {
  id              String   @id @default(uuid(7)) @db.Uuid
  estateId        String   @map("estate_id") @db.Uuid
  householdId     String   @map("household_id") @db.Uuid
  /// Uppercase, no spaces or dashes.
  plateNormalised String   @map("plate_normalised")
  plateDisplay    String   @map("plate_display")
  make            String?
  model           String?
  colour          String?
  tagNumber       String?  @map("tag_number")
  /// active | inactive
  status          String   @default("active")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([estateId, householdId])
  @@map("vehicles")
  @@schema("tenant")
}

model DomesticStaff {
  id          String   @id @default(uuid(7)) @db.Uuid
  estateId    String   @map("estate_id") @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  name        String
  phone       String?
  /// cleaner | driver | nanny | security | cook | gardener | other
  role        String
  /// { days: [0-6], from: "HH:MM", to: "HH:MM" }
  schedule    Json     @db.JsonB
  /// pending | active | suspended | ended
  status      String
  approvedBy  String?  @map("approved_by") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([estateId, householdId])
  @@index([estateId, status])
  @@map("domestic_staff")
  @@schema("tenant")
}

/// A user's emergency contacts (all estates). Read by the emergency module only during an active SOS.
model EmergencyContact {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  name               String
  phone              String
  relationship       String
  consentConfirmedAt DateTime @map("consent_confirmed_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("emergency_contacts")
  @@schema("platform")
}

// ---------------------------------------------------------------------------------------------------
// Security (Phase 1, security.md): gates. Personnel, shifts and incidents follow.
// ---------------------------------------------------------------------------------------------------

model Gate {
  id        String   @id @default(uuid(7)) @db.Uuid
  estateId  String   @map("estate_id") @db.Uuid
  name      String
  /// pedestrian | vehicle | both
  type      String
  /// active | inactive
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([estateId, status])
  @@map("gates")
  @@schema("tenant")
}

// ---------------------------------------------------------------------------------------------------
// Visitor (Phase 1, visitor.md). Pass token design: ADR-0010.
// ---------------------------------------------------------------------------------------------------

/// Per-estate Ed25519 key pair. The private key is wrapped by the KeyVault adapter.
model EstateSigningKey {
  id                String    @id @default(uuid(7)) @db.Uuid
  estateId          String    @map("estate_id") @db.Uuid
  /// Small integer carried in each QR token.
  keyIndex          Int       @map("key_index")
  publicKey         String    @map("public_key")
  privateKeyWrapped String    @map("private_key_wrapped")
  activeFrom        DateTime  @default(now()) @map("active_from") @db.Timestamptz(3)
  /// Tokens signed with a retired key stay valid until this time.
  activeTo          DateTime? @map("active_to") @db.Timestamptz(3)

  @@unique([estateId, keyIndex])
  @@map("estate_signing_keys")
  @@schema("tenant")
}

model VisitorInvitation {
  id              String   @id @default(uuid(7)) @db.Uuid
  estateId        String   @map("estate_id") @db.Uuid
  hostUserId      String   @map("host_user_id") @db.Uuid
  /// Null for passes created by management (e.g. a contractor for the estate).
  hostHouseholdId String?  @map("host_household_id") @db.Uuid
  spaceId         String?  @map("space_id") @db.Uuid
  /// one_time | multi_entry | recurring | domestic_staff | delivery
  type            String
  purpose         String?
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  passes VisitorPass[]

  @@index([estateId, hostHouseholdId])
  @@map("visitor_invitations")
  @@schema("tenant")
}

model VisitorPass {
  id               String    @id @default(uuid(7)) @db.Uuid
  estateId         String    @map("estate_id") @db.Uuid
  invitationId     String    @map("invitation_id") @db.Uuid
  visitorName      String    @map("visitor_name")
  visitorPhone     String?   @map("visitor_phone")
  vehiclePlate     String?   @map("vehicle_plate")
  /// HMAC of estate + PIN; unique among live passes (partial index in the migration).
  pinLookup        String    @map("pin_lookup")
  /// PIN wrapped by the KeyVault, so the host and the pass page can show it again.
  pinWrapped       String    @map("pin_wrapped")
  /// SHA-256 of the public pass-page token (the token is derived, never stored).
  publicTokenHash  String    @unique @map("public_token_hash")
  validFrom        DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo          DateTime  @map("valid_to") @db.Timestamptz(3)
  recurrence       Json?     @db.JsonB
  gateIds          String[]  @map("gate_ids") @db.Uuid
  /// Null = unlimited within the window.
  maxUses          Int?      @map("max_uses")
  usesCount        Int       @default(0) @map("uses_count")
  domesticStaffId  String?   @map("domestic_staff_id") @db.Uuid
  keyIndex         Int       @map("key_index")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy        String?   @map("revoked_by") @db.Uuid
  revocationReason String?   @map("revocation_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  invitation VisitorInvitation @relation(fields: [invitationId], references: [id])

  @@index([estateId, validFrom, validTo])
  @@index([estateId, revokedAt])
  @@index([invitationId])
  @@map("visitor_passes")
  @@schema("tenant")
}

/// Append-only. Not partitioned yet (ADR-0010); `client_uuid` makes offline sync idempotent.
model GateEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  estateId       String   @map("estate_id") @db.Uuid
  gateId         String   @map("gate_id") @db.Uuid
  passId         String?  @map("pass_id") @db.Uuid
  walkinId       String?  @map("walkin_id") @db.Uuid
  /// in | out
  direction      String
  visitorName    String?  @map("visitor_name")
  vehiclePlate   String?  @map("vehicle_plate")
  /// allow | check | deny | override
  decision       String
  decisionReason String?  @map("decision_reason")
  guardUserId    String   @map("guard_user_id") @db.Uuid
  deviceId       String?  @map("device_id")
  clientUuid     String   @map("client_uuid") @db.Uuid
  /// Device time.
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  /// Device clock differed from the server by more than 5 minutes.
  clockSkewed    Boolean  @default(false) @map("clock_skewed")
  offline        Boolean  @default(false)

  @@unique([estateId, clientUuid])
  @@index([estateId, occurredAt])
  @@index([estateId, passId])
  @@map("gate_events")
  @@schema("tenant")
}

model WalkinRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  estateId     String    @map("estate_id") @db.Uuid
  gateId       String    @map("gate_id") @db.Uuid
  spaceId      String    @map("space_id") @db.Uuid
  householdId  String    @map("household_id") @db.Uuid
  visitorName  String    @map("visitor_name")
  visitorPhone String?   @map("visitor_phone")
  purpose      String?
  vehiclePlate String?   @map("vehicle_plate")
  /// pending | approved | rejected | timed_out | cancelled
  status       String    @default("pending")
  respondedBy  String?   @map("responded_by") @db.Uuid
  respondedAt  DateTime? @map("responded_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  guardUserId  String    @map("guard_user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([estateId, status, expiresAt])
  @@index([estateId, householdId])
  @@map("walkin_requests")
  @@schema("tenant")
}

model RestrictedVisitor {
  id              String    @id @default(uuid(7)) @db.Uuid
  estateId        String    @map("estate_id") @db.Uuid
  name            String?
  phone           String?
  plateNormalised String?   @map("plate_normalised")
  reason          String
  addedBy         String    @map("added_by") @db.Uuid
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([estateId])
  @@map("restricted_visitors")
  @@schema("tenant")
}

// ---------------------------------------------------------------------------------------------------
// Emergency (Phase 1, emergency.md). Escalation steps come from the estate setting `sos.escalation`.
// ---------------------------------------------------------------------------------------------------

model SosAlert {
  id             String    @id @default(uuid(7)) @db.Uuid
  estateId       String    @map("estate_id") @db.Uuid
  triggeredBy    String    @map("triggered_by") @db.Uuid
  /// resident | guard | staff
  triggerRole    String    @map("trigger_role")
  householdId    String?   @map("household_id") @db.Uuid
  spaceId        String?   @map("space_id") @db.Uuid
  /// security_threat | medical | fire | accident | suspicious_activity | general
  category       String
  isDrill        Boolean   @default(false) @map("is_drill")
  /// app | sms | device
  source         String    @default("app")
  /// triggered | acknowledged | assigned | responding | resolved | closed | cancelled
  status         String    @default("triggered")
  triggeredAt    DateTime  @default(now()) @map("triggered_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  assignedTo     String?   @map("assigned_to") @db.Uuid
  respondingAt   DateTime? @map("responding_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolution     String?
  falseAlarm     Boolean   @default(false) @map("false_alarm")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  closedBy       String?   @map("closed_by") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  clientUuid     String    @map("client_uuid") @db.Uuid
  version        Int       @default(1)

  @@unique([estateId, clientUuid])
  @@index([estateId, status, triggeredAt])
  @@map("sos_alerts")
  @@schema("tenant")
}

/// Collected only between trigger and resolution (AGENTS.md §6.6).
model SosLocation {
  id         String   @id @default(uuid(7)) @db.Uuid
  estateId   String   @map("estate_id") @db.Uuid
  alertId    String   @map("alert_id") @db.Uuid
  lat        Float
  lng        Float
  accuracyM  Float?   @map("accuracy_m")
  capturedAt DateTime @map("captured_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([alertId, capturedAt])
  @@map("sos_locations")
  @@schema("tenant")
}

/// Append-only timeline: every state change and notification (emergency.md §8.6).
model SosEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  estateId   String   @map("estate_id") @db.Uuid
  alertId    String   @map("alert_id") @db.Uuid
  /// triggered | retriggered | notified | escalated | acknowledged | assigned | responding | note | resolved | closed | cancelled
  type       String
  actorId    String?  @map("actor_id") @db.Uuid
  /// push | sms | voice | in_app (notified events)
  channel    String?
  payload    Json     @default("{}") @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([alertId, occurredAt])
  @@map("sos_events")
  @@schema("tenant")
}

model EmergencyBroadcast {
  id         String   @id @default(uuid(7)) @db.Uuid
  estateId   String   @map("estate_id") @db.Uuid
  title      String
  body       String
  sentBy     String   @map("sent_by") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)
  recipients Int      @default(0)

  @@index([estateId, sentAt])
  @@map("emergency_broadcasts")
  @@schema("tenant")
}

// ---------------------------------------------------------------------------------------------------
// Community, Phase 1 part: official announcements (community.md). Channels and messaging are Phase 3.
// ---------------------------------------------------------------------------------------------------

model Announcement {
  id               String   @id @default(uuid(7)) @db.Uuid
  estateId         String   @map("estate_id") @db.Uuid
  title            String
  body             String
  /// general | security | maintenance | event | billing
  category         String   @default("general")
  /// normal | important (important also goes by SMS)
  priority         String   @default("normal")
  /// estate | spaces
  audienceType     String   @map("audience_type")
  /// The spaces chosen (buildings, blocks, units).
  audienceSpaceIds String[] @map("audience_space_ids") @db.Uuid
  /// Units covered, resolved at publication, for filtering what a resident sees.
  audienceUnitIds  String[] @map("audience_unit_ids") @db.Uuid
  authorId         String   @map("author_id") @db.Uuid
  publishedAt      DateTime @default(now()) @map("published_at") @db.Timestamptz(3)
  recipients       Int      @default(0)

  @@index([audienceUnitIds], type: Gin, map: "announcements_audience_units")
  @@index([estateId, publishedAt])
  @@map("announcements")
  @@schema("tenant")
}

model AnnouncementRead {
  estateId       String   @map("estate_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  @@id([announcementId, userId])
  @@map("announcement_reads")
  @@schema("tenant")
}
