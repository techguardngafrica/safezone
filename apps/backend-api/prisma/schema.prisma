// Safezone Prisma Schema Foundation
// Multi-tenancy, PostgreSQL Row-Level Security (RLS), and PostGIS conventions
// are documented in docs/database/.
//
// Business domain models will be added incrementally per module milestone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

