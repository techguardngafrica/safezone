{
  "name": "@safezone/backend-api",
  "version": "0.0.0",
  "private": true,
  "description": "Safezone backend — NestJS modular monolith with API, worker and realtime entry points",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "dev:realtime": "nest start --watch --entryFile realtime",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:realtime": "node dist/realtime.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "test": "prisma generate && vitest run",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:app-role": "node scripts/db-app-role.mjs",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist .turbo coverage src/generated",
    "db:seed": "node dist/scripts/seed.js",
    "db:seed:dev": "node dist/scripts/seed.js --dev",
    "openapi": "pnpm build && node dist/scripts/generate-openapi.js && pnpm --filter @safezone/contracts generate",
    "test:integration:host": "prisma generate && node scripts/test-host.mjs",
    "test:isolation": "prisma generate && vitest run --config vitest.integration.config.ts test/isolation",
    "dev:otp": "node scripts/dev-otp.mjs",
    "dev:otp:reset": "node scripts/dev-otp-reset.mjs",
    "dev:demo-data": "node dist/scripts/dev-demo-data.js",
    "dev:demo-billing": "node dist/scripts/dev-demo-data.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/websockets": "^12.5.0",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@safezone/auth": "workspace:*",
    "@safezone/i18n": "workspace:*",
    "@safezone/permissions": "workspace:*",
    "@safezone/schemas": "workspace:*",
    "@safezone/types": "workspace:*",
    "@sentry/nestjs": "11.12.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.7.6",
    "expo-server-sdk": "8.0.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@safezone/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "12.2.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
