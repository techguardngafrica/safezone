{
  "name": "@safezone/security-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Safezone Security App (Expo) — gate verification, offline passes, SOS response, incidents, shifts. No advertising.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "vitest run --passWithNoTests",
    "doctor": "expo install --check",
    "clean": "rm -rf .expo .turbo"
  },
  "dependencies": {
    "@safezone/api-client": "workspace:*",
    "@safezone/auth": "workspace:*",
    "@safezone/design-tokens": "workspace:*",
    "@safezone/i18n": "workspace:*",
    "@safezone/mobile-ui": "workspace:*",
    "@safezone/schemas": "workspace:*",
    "@safezone/types": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "vitest": "^5.1.0"
  }
}
