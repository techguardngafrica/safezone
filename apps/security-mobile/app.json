{
  "expo": {
    "name": "Safezone Security",
    "slug": "safezone-security",
    "scheme": "safezone-security",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#254D42",
    "backgroundColor": "#FAF7F2",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#254D42"
    },
    "ios": {
      "bundleIdentifier": "ng.gsssecurity.safezone.security",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "The camera scans visitor pass QR codes and takes visitor or vehicle photos when your estate requires it."
      }
    },
    "android": {
      "package": "ng.gsssecurity.safezone.security",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#254D42"
      },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "realtimeUrl": "ws://localhost:4001"
    }
  }
}
