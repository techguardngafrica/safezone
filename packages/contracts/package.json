{
  "name": "@safezone/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API contract: the OpenAPI 3.1 document generated from backend-api, plus generated path types",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/openapi.d.ts && prettier --write src/generated/openapi.d.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/generated && cp src/generated/openapi.d.ts dist/generated/openapi.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.1.0"
  }
}
