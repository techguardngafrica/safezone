{
  "name": "@safezone/web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components for the Next.js apps (management-web, super-admin, public-web)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@safezone/design-tokens": "workspace:*",
    "@safezone/i18n": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "react": "19.3.0",
    "vitest": "^5.1.0"
  }
}
