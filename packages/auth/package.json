{
  "name": "@safezone/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Shared auth utilities: token storage contract, expiry checks, session state",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@safezone/types": "workspace:*"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "eslint": "^10.14.0",
    "vitest": "^5.1.0"
  }
}
