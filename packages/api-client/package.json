{
  "name": "@safezone/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client for the Safezone API, generated from @safezone/contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@safezone/auth": "workspace:*",
    "@safezone/contracts": "workspace:*",
    "@safezone/schemas": "workspace:*",
    "@safezone/types": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@safezone/config": "workspace:*",
    "eslint": "^10.14.0",
    "vitest": "^5.1.0"
  }
}
