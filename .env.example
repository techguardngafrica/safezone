# Copy to apps/backend-api/.env for local development.
# Local infrastructure comes from infrastructure/docker/docker-compose.yml (pnpm infra:up).

NODE_ENV=development
APP_PROCESS=api            # api | worker | realtime
API_PORT=4000
REALTIME_PORT=4001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Forced / soft update prompts (GET /v1/public/app-config)
APP_MIN_VERSION=0.0.0
APP_RECOMMENDED_VERSION=0.0.0

DATABASE_URL=postgres://safezone:safezone@localhost:5432/safezone
DATABASE_REPLICA_URL=postgres://safezone:safezone@localhost:5432/safezone
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-local-only
REFRESH_TOKEN_TTL_DAYS=30

STORAGE_BUCKET=safezone-local
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000

# Email: Zoho SMTP in staging/production; Mailpit locally
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@safezone.local

# Push: Expo Notifications
EXPO_ACCESS_TOKEN=

# Providers (sandbox keys only in development)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
SMS_PROVIDER=termii
SMS_API_KEY=
SMS_SENDER_ID=Safezone
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VOICE_PROVIDER=africastalking
VOICE_API_KEY=
KYC_PROVIDER=
KYC_API_KEY=
BILLS_PROVIDER=
BILLS_API_KEY=
GOOGLE_MAPS_KEY=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
