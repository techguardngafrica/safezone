# Copy to apps/backend-api/.env for local development.
# Local infrastructure comes from infrastructure/docker/docker-compose.yml (pnpm infra:up).

NODE_ENV=development
APP_PROCESS=api            # api | worker | realtime
API_PORT=4000
REALTIME_PORT=4001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Invitation links open management-web (https in staging/production).
MANAGEMENT_WEB_URL=http://localhost:3001
# Visitor pass links open public-web (https in staging/production).
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info              # debug | info | warn | error
TRUST_PROXY_HOPS=0          # proxies in front of the API (for client IP)

# Forced / soft update prompts (GET /v1/public/app-config)
APP_MIN_VERSION=0.0.0
APP_RECOMMENDED_VERSION=0.0.0

# Runtime connects as safezone_app, which cannot bypass row-level security (ADR-0001).
DATABASE_URL=postgres://safezone_app:safezone_app@localhost:5432/safezone
DATABASE_REPLICA_URL=postgres://safezone_app:safezone_app@localhost:5432/safezone
DATABASE_POOL_MAX=10
# Migrations only (pnpm db:migrate): the schema owner. Never given to API, worker or realtime.
DATABASE_MIGRATION_URL=postgres://safezone:safezone@localhost:5432/safezone
REDIS_URL=redis://localhost:6379

# Secrets: >= 32 chars, all different. Staging/production refuse placeholders. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=local-only-access-secret-change-me-0000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=local-only-refresh-secret-change-me-000000000
JWT_REFRESH_TTL=30d
OTP_HMAC_SECRET=local-only-otp-secret-change-me-00000000000000
# AES-256-GCM key for TOTP secrets (32 bytes, base64). Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
# Encrypts estate visitor-pass signing keys and pass PINs (32 bytes, base64). Must differ from MFA_ENCRYPTION_KEY.
PASS_KEY_ENCRYPTION_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=

STORAGE_BUCKET=safezone-local
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minio
STORAGE_SECRET_ACCESS_KEY=minio-password
STORAGE_FORCE_PATH_STYLE=true

# Email: Zoho SMTP in staging/production; Mailpit locally
# --- Mail SMTP Configuration (required to deliver support / data-export notification emails) ---
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false      # true for Zoho on 465
# Must be the SMTP login (or a Zoho alias of it). Zoho rejects other From addresses with 553.
MAIL_SMTP_FROM=no-reply@safezone.local

# Push: Expo Notifications
EXPO_ACCESS_TOKEN=

# Providers (sandbox keys only in development)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
SMS_PROVIDER=fake           # fake | termii (fake is refused in staging/production)
SMS_API_KEY=
SMS_SENDER_ID=Safezone
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VOICE_PROVIDER=fake         # fake | africastalking | twilio
VOICE_API_KEY=
KYC_PROVIDER=
KYC_API_KEY=
BILLS_PROVIDER=
BILLS_API_KEY=
GOOGLE_MAPS_KEY=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
