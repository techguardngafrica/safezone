set -e

echo "Running pre-push auto-fixes (Prettier & ESLint)..."
before_status="$(git status --porcelain)"

pnpm format
pnpm lint:fix

after_status="$(git status --porcelain)"
if [ "$before_status" != "$after_status" ]; then
  echo ""
  echo "Pre-push auto-fix modified files in your working tree:"
  git status --short
  echo ""
  echo "Please review, stage, and commit these fixes before pushing."
  exit 1
fi

echo "Running pre-push verification checks (format, lint, typecheck, test, build)..."
pnpm format:check
pnpm lint
pnpm typecheck
pnpm test
pnpm build

echo "All pre-push checks passed."

